# Copy to .env and fill in. docker-compose.yml sets DATABASE_URL and REDIS_URL itself.

# Any long random string.
SECRET_KEY=change-me

# Encrypts SMTP passwords, bot tokens and header values at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: without it the saved secrets cannot be read.
ENCRYPTION_KEY=

# The address people reach Post Office at. Used in tracking, unsubscribe and signup links.
PUBLIC_URL=http://localhost:8000

# polling works behind a home router; webhook needs PUBLIC_URL to be reachable over https.
TELEGRAM_MODE=polling

# Allow Telegram commands to call services on your own network (loopback and link-local addresses).
ALLOW_PRIVATE_TARGETS=0

# Not used yet: Gatehouse sign-in is not built. See README.md.
# GATEHOUSE_ISSUER=
# GATEHOUSE_CLIENT_ID=
# GATEHOUSE_CLIENT_SECRET=
